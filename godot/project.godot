; Giza Plateau — native build (Godot 4.5). Models come from Blender
; (tools/blender/), data from tools/export_godot_data.mjs.
config_version=5

[application]
config/name="Giza Plateau"
config/description="An explorable, to-scale reconstruction of the Giza Plateau and the Serapeum of Saqqara."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2

